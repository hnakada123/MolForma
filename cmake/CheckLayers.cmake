cmake_minimum_required(VERSION 3.21)
# Project-header dependencies must follow the same direction as the library targets.
if(NOT DEFINED MOLFORMA_SOURCE_DIR)
    message(FATAL_ERROR "Set MOLFORMA_SOURCE_DIR to the source directory")
endif()
set(layers foundation project model editing results nwchem io mcp ui)
set(foundation_dependencies foundation)
set(project_dependencies project)
set(model_dependencies foundation model project)
set(editing_dependencies foundation editing model)
set(results_dependencies foundation results model)
set(nwchem_dependencies foundation nwchem model editing results)
set(io_dependencies foundation io model editing nwchem results)
set(mcp_dependencies foundation mcp model editing results nwchem io)
set(ui_dependencies ${layers})
# Open Babel is called by the layers that link it (CMakeLists.txt): what the others need of an element or
# a structure, they ask of those.
set(openbabel_layers editing nwchem io)
foreach(layer IN LISTS layers)
    file(GLOB files "${MOLFORMA_SOURCE_DIR}/${layer}/*.cpp" "${MOLFORMA_SOURCE_DIR}/${layer}/*.h")
    foreach(source IN LISTS files)
        if(NOT layer IN_LIST openbabel_layers)
            file(STRINGS "${source}" babel REGEX "^[ \t]*#[ \t]*include[ \t]+<openbabel/")
            if(babel)
                message(FATAL_ERROR "Open Babel is not called from this layer: ${source}: ${babel}")
            endif()
        endif()
        file(STRINGS "${source}" includes REGEX "^[ \t]*#[ \t]*include[ \t]+\"")
        foreach(include IN LISTS includes)
            # Workspace panels communicate through requests wired by WorkspaceController.
            # Only the molecular workspace composes another panel (its coordinate table).
            get_filename_component(filename "${source}" NAME_WE)
            if(layer STREQUAL "ui" AND NOT filename MATCHES "^(main_window|mcp_gui|workspace_controller)$"
               AND include MATCHES "ui/main_window")
                message(FATAL_ERROR "UI consumers must use editor_context interfaces: ${source}: ${include}")
            endif()
            if(layer STREQUAL "ui" AND filename MATCHES "^(calculation|coordinates|execution|history|input_preview|results|molecule)_(panel|properties)$")
                set(owner "${CMAKE_MATCH_1}")
                if(include MATCHES "include[ \t]+\"ui/([a-z_]+)_panel\\.h\"")
                    set(panel "${CMAKE_MATCH_1}")
                    if(NOT panel STREQUAL owner AND NOT (owner STREQUAL "molecule" AND panel STREQUAL "coordinates"))
                        message(FATAL_ERROR "Forbidden panel dependency: ${source}: ${include}")
                    endif()
                endif()
            endif()
            # The parts of a panel (its views, pages, palette and dialogs) see neither the panel that
            # composes them nor another: what they ask of it is a signal of theirs.
            if(layer STREQUAL "ui"
               AND filename MATCHES "^(result_[a-z_]+|cube_combine_dialog|part_palette|property_page|[a-z]+_page|molecule_dialogs|selection_controls)$"
               AND include MATCHES "ui/[a-z_]+_panel\\.h")
                message(FATAL_ERROR "A part of a panel must not include a panel: ${source}: ${include}")
            endif()
            if(include MATCHES "include[ \t]+\"([a-z]+)/")
                set(dependency "${CMAKE_MATCH_1}")
                if(dependency IN_LIST layers AND NOT dependency IN_LIST ${layer}_dependencies)
                    message(FATAL_ERROR "Forbidden source dependency: ${source}: ${include}")
                endif()
            endif()
        endforeach()
    endforeach()
endforeach()
# The tests are laid out by layer too: the executables that link the core alone (CMakeLists.txt), and
# the helpers they share, include nothing of the UI, and of MCP only the test of its server does.
get_filename_component(tests "${MOLFORMA_SOURCE_DIR}/../tests" ABSOLUTE)
foreach(name IN ITEMS test_core.cpp test_services.cpp test_nwchem.cpp test_runs.cpp test_result_readers.cpp
        test_mcp_server.cpp test_support.h nwchem_support.h run_support.h result_support.h mcp_support.h)
    if(NOT EXISTS "${tests}/${name}")
        continue()
    endif()
    file(STRINGS "${tests}/${name}" includes REGEX "^[ \t]*#[ \t]*include[ \t]+\"")
    foreach(include IN LISTS includes)
        if(include MATCHES "\"ui/" OR (include MATCHES "\"mcp/"
           AND NOT name MATCHES "^(test_mcp_server\\.cpp|mcp_support\\.h)$"))
            message(FATAL_ERROR "A test of the core must not include this layer: ${tests}/${name}: ${include}")
        endif()
    endforeach()
endforeach()
