<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- MolForma.app (docs/installation/macos.md); CMakeLists.txt fills in the version. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>ja</string>
  <key>CFBundleDisplayName</key>
  <string>MolForma</string>
  <key>CFBundleExecutable</key>
  <string>molforma</string>
  <key>CFBundleIconFile</key>
  <string>molforma.icns</string>
  <key>CFBundleIdentifier</key>
  <string>io.github.hnakada123.MolForma</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>MolForma</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@PROJECT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@PROJECT_VERSION@</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>ja</string>
    <string>en</string>
  </array>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.education</string>
  <key>LSMinimumSystemVersion</key>
  <string>@MOLFORMA_MACOS_MINIMUM@</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
  <key>NSHumanReadableCopyright</key>
  <string>GPL-2.0-or-later</string>
  <!-- Files MolForma opens from Finder ("Open With"); NWChem input by default. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>NWChem input</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>nw</string>
      </array>
      <key>LSHandlerRank</key>
      <string>Owner</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Molecular structure</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>xyz</string>
        <string>mol</string>
        <string>sdf</string>
        <string>mol2</string>
        <string>cml</string>
        <string>pdb</string>
        <string>ent</string>
        <string>cif</string>
        <string>mmcif</string>
        <string>gjf</string>
        <string>com</string>
      </array>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>MolForma project</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.json</string>
      </array>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
    </dict>
  </array>
</dict>
</plist>
