# Makes MolForma.app self-contained (docs/installation/macos.md); run at install time with
#   APP          the bundle
#   MACDEPLOYQT  Qt's macdeployqt
#   SEARCH       folders of the libraries that @rpath references name (Qt's lib folder, then Homebrew's)
#   OPENBABEL_PLUGINS  the folder of Open Babel's format plugins (*.so)
# macdeployqt copies Qt's frameworks and plugins. Then every Mach-O file of the bundle (the executable,
# the frameworks and libraries, Qt's and Open Babel's plugins) gets the libraries it links outside the
# system copied into Contents/Frameworks, its references pointed at those copies through @rpath, and
# rpaths into the bundle alone: libraries reached through build-time rpaths would otherwise still load
# from Homebrew, beside their copies. Last, the bundle is signed ad hoc (Apple silicon runs only signed
# code).
cmake_minimum_required(VERSION 3.21)
set(contents "${APP}/Contents")
set(frameworks "${contents}/Frameworks")

message(STATUS "Copying Qt into ${APP}")
set(options)
foreach(dir IN LISTS SEARCH)
    list(APPEND options "-libpath=${dir}")
endforeach()
execute_process(COMMAND "${MACDEPLOYQT}" "${APP}" ${options} -no-codesign -always-overwrite -verbose=0
    COMMAND_ERROR_IS_FATAL ANY)

# VTK's libraries name the Qt they were built for, and macdeployqt follows that too. A build with another
# Qt of that version (release.sh) must hold that Qt alone, and not what only Homebrew's Qt links: OpenSSL.
list(GET SEARCH 0 qt_libraries)
file(GLOB modules RELATIVE "${frameworks}" "${frameworks}/Qt*.framework")
foreach(framework IN LISTS modules)
    string(REGEX REPLACE "\\.framework$" "" module "${framework}")
    set(binary "${framework}/Versions/A/${module}")
    if(EXISTS "${qt_libraries}/${binary}")
        file(REMOVE "${frameworks}/${binary}")
        file(COPY_FILE "${qt_libraries}/${binary}" "${frameworks}/${binary}")
        file(CHMOD "${frameworks}/${binary}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ
            GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    endif()
endforeach()
execute_process(COMMAND otool -L "${frameworks}/QtNetwork.framework/Versions/A/QtNetwork" OUTPUT_VARIABLE linked
    COMMAND_ERROR_IS_FATAL ANY)
if(NOT linked MATCHES "libssl")
    file(GLOB openssl "${frameworks}/libssl.*" "${frameworks}/libcrypto.*")
    if(openssl)
        file(REMOVE ${openssl})
    endif()
endif()

# After macdeployqt, which would go through each of them (minutes).
file(GLOB plugins "${OPENBABEL_PLUGINS}/*.so")
file(MAKE_DIRECTORY "${contents}/PlugIns/openbabel")
# Writable, unlike Homebrew's: "xattr -dr com.apple.quarantine" must reach them on a Mac that received the app.
file(COPY ${plugins} DESTINATION "${contents}/PlugIns/openbabel" FILE_PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ
    WORLD_READ)

function(macho_files out)
    file(GLOB_RECURSE candidates LIST_DIRECTORIES false "${contents}/MacOS/*" "${contents}/Frameworks/*"
        "${contents}/PlugIns/*")
    set(found)
    foreach(file IN LISTS candidates)
        if(IS_SYMLINK "${file}" OR file MATCHES "/(Headers|Resources)/")
            continue()
        endif()
        execute_process(COMMAND file -b "${file}" OUTPUT_VARIABLE kind)
        if(kind MATCHES "^Mach-O")
            list(APPEND found "${file}")
        endif()
    endforeach()
    set(${out} "${found}" PARENT_SCOPE)
endfunction()

# The rpath that leads from the folder of a file to Contents/Frameworks.
function(bundle_rpath file out)
    get_filename_component(dir "${file}" DIRECTORY)
    if(dir STREQUAL "${contents}/MacOS")
        set(${out} "@executable_path/../Frameworks" PARENT_SCOPE)
    else()
        file(RELATIVE_PATH relative "${dir}" "${frameworks}")
        if(relative STREQUAL "")
            set(${out} "@loader_path" PARENT_SCOPE)
        else()
            set(${out} "@loader_path/${relative}" PARENT_SCOPE)
        endif()
    endif()
endfunction()

function(find_library_file name out)
    foreach(dir IN LISTS SEARCH)
        if(EXISTS "${dir}/${name}")
            set(${out} "${dir}/${name}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "${name} not found in ${SEARCH}")
endfunction()

macho_files(queue)
set(done)
while(queue)
    list(POP_FRONT queue file)
    list(APPEND done "${file}")
    execute_process(COMMAND otool -L "${file}" OUTPUT_VARIABLE linked COMMAND_ERROR_IS_FATAL ANY)
    string(REPLACE "\n" ";" linked "${linked}")
    list(POP_FRONT linked) # The file name.
    execute_process(COMMAND otool -D "${file}" OUTPUT_VARIABLE own)
    string(REGEX REPLACE "^[^\n]*\n" "" own "${own}")
    string(STRIP "${own}" own)
    set(changes)
    foreach(line IN LISTS linked)
        string(REGEX REPLACE "^[ \t]*([^ \t].*) \\(compatibility.*$" "\\1" reference "${line}")
        if(reference STREQUAL "" OR reference STREQUAL own OR reference MATCHES "^(/usr/lib/|/System/)")
            continue()
        endif()
        if(reference MATCHES "\\.framework/")
            # Qt's frameworks, which macdeployqt copied: by their path below Frameworks.
            string(REGEX REPLACE "^.*/([^/]+\\.framework/.*)$" "\\1" inside "${reference}")
            if(NOT EXISTS "${frameworks}/${inside}")
                message(FATAL_ERROR "${file} links ${reference}, which is not in the bundle")
            endif()
            set(target "@rpath/${inside}")
        else()
            get_filename_component(name "${reference}" NAME)
            if(NOT EXISTS "${frameworks}/${name}")
                if(IS_ABSOLUTE "${reference}")
                    set(source "${reference}")
                else()
                    find_library_file("${name}" source)
                endif()
                file(REAL_PATH "${source}" source)
                file(COPY_FILE "${source}" "${frameworks}/${name}")
                file(CHMOD "${frameworks}/${name}" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
                list(APPEND queue "${frameworks}/${name}")
            endif()
            set(target "@rpath/${name}")
        endif()
        if(NOT reference STREQUAL target)
            list(APPEND changes -change "${reference}" "${target}")
        endif()
    endforeach()
    if(own AND NOT own MATCHES "^@rpath/")
        get_filename_component(name "${file}" NAME)
        if(file MATCHES "\\.framework/")
            string(REGEX REPLACE "^.*/([^/]+\\.framework/.*)$" "\\1" name "${file}")
        endif()
        list(APPEND changes -id "@rpath/${name}")
    endif()
    # Only rpaths into the bundle: those of the build and of Homebrew go.
    execute_process(COMMAND otool -l "${file}" OUTPUT_VARIABLE commands)
    string(REGEX MATCHALL "cmd LC_RPATH\n[^\n]*\n[ \t]*path [^\n]* \\(offset" rpaths "${commands}")
    bundle_rpath("${file}" wanted)
    set(present FALSE)
    foreach(rpath IN LISTS rpaths)
        string(REGEX REPLACE ".*path (.*) \\(offset$" "\\1" rpath "${rpath}")
        if(rpath STREQUAL wanted AND NOT present)
            set(present TRUE)
        else()
            list(APPEND changes -delete_rpath "${rpath}")
        endif()
    endforeach()
    if(NOT present)
        list(APPEND changes -add_rpath "${wanted}")
    endif()
    if(NOT changes) # A library of a Qt built with @rpath references, for one.
        continue()
    endif()
    execute_process(COMMAND install_name_tool ${changes} "${file}" RESULT_VARIABLE failed ERROR_VARIABLE warnings)
    string(REGEX REPLACE "[^\n]*will invalidate the code signature[^\n]*\n?" "" warnings "${warnings}")
    if(failed)
        message(FATAL_ERROR "install_name_tool ${changes} ${file}: ${warnings}")
    elseif(warnings)
        message(WARNING "${file}: ${warnings}")
    endif()
endwhile()
list(LENGTH done count)
message(STATUS "Pointed ${count} files at the libraries in the bundle")

# The license texts of the Homebrew packages whose libraries the bundle holds, in Resources/licenses,
# and a list of those packages with their versions and licenses (Homebrew's formulae name them also
# where the package has no license file).
file(REAL_PATH "${OPENBABEL_PLUGINS}" origin)
set(origins "${origin}")
file(GLOB copied RELATIVE "${frameworks}" "${frameworks}/*")
foreach(name IN LISTS copied)
    # Also in the lib folders of keg-only packages (ICU, which Qt links).
    set(places)
    foreach(dir IN LISTS SEARCH)
        list(APPEND places "${dir}/${name}")
        file(GLOB kept "${dir}/../opt/*/lib/${name}")
        list(APPEND places ${kept})
    endforeach()
    foreach(place IN LISTS places)
        if(EXISTS "${place}")
            file(REAL_PATH "${place}" origin)
            list(APPEND origins "${origin}")
            break()
        endif()
    endforeach()
endforeach()
set(kegs)
foreach(origin IN LISTS origins)
    if(origin MATCHES "^(.*/Cellar/[^/]+/[^/]+)/")
        list(APPEND kegs "${CMAKE_MATCH_1}")
    endif()
endforeach()
list(REMOVE_DUPLICATES kegs)
set(licenses "${contents}/Resources/licenses")
file(REMOVE_RECURSE "${licenses}")
set(formulae)
foreach(keg IN LISTS kegs)
    string(REGEX REPLACE "^.*/Cellar/([^/]+)/([^/]+)$" "\\1" formula "${keg}")
    list(APPEND formulae "${formula}")
    file(GLOB texts LIST_DIRECTORIES false "${keg}/*LICENSE*" "${keg}/*LICENCE*" "${keg}/*COPYING*"
        "${keg}/*NOTICE*" "${keg}/*Copyright*" "${keg}/*license*" "${keg}/*copying*")
    if(texts)
        file(COPY ${texts} DESTINATION "${licenses}/${formula}")
    endif()
endforeach()
find_program(BREW brew HINTS /opt/homebrew/bin /usr/local/bin)
set(list "The Homebrew packages whose libraries MolForma.app holds (name, version, license):\n")
if(BREW AND formulae)
    execute_process(COMMAND "${BREW}" info --json=v2 ${formulae} OUTPUT_VARIABLE info RESULT_VARIABLE failed
        ERROR_QUIET)
endif()
foreach(keg IN LISTS kegs)
    string(REGEX REPLACE "^.*/Cellar/([^/]+)/([^/]+)$" "\\1;\\2" entry "${keg}")
    list(GET entry 0 formula)
    list(GET entry 1 version)
    set(license "")
    if(info AND NOT failed)
        string(JSON count LENGTH "${info}" formulae)
        math(EXPR last "${count} - 1")
        foreach(i RANGE ${last})
            string(JSON name GET "${info}" formulae ${i} name)
            if(name STREQUAL formula)
                string(JSON license ERROR_VARIABLE none GET "${info}" formulae ${i} license)
            endif()
        endforeach()
    endif()
    string(APPEND list "${formula} ${version} ${license}\n")
endforeach()
file(WRITE "${licenses}/packages.txt" "${list}")
list(LENGTH kegs count)
message(STATUS "Recorded the licenses of ${count} Homebrew packages")
# A release (release.sh) adds the license texts that no Homebrew folder holds and the lines of its Qt.
if(DEFINED ENV{MOLFORMA_RELEASE_LICENSES})
    file(GLOB extra "$ENV{MOLFORMA_RELEASE_LICENSES}/*")
    list(REMOVE_ITEM extra "$ENV{MOLFORMA_RELEASE_LICENSES}/packages.txt")
    file(COPY ${extra} DESTINATION "${licenses}")
    file(READ "$ENV{MOLFORMA_RELEASE_LICENSES}/packages.txt" lines)
    file(APPEND "${licenses}/packages.txt" "${lines}")
endif()

execute_process(COMMAND codesign --force --deep --sign - "${APP}" OUTPUT_QUIET ERROR_QUIET
    COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND codesign --verify --deep --strict "${APP}" COMMAND_ERROR_IS_FATAL ANY)
